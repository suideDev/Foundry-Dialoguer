<div class="standard-form">
  {{#if showEnabled}}
  <div class="form-group">
    <label>{{localize "DIALOGUER.Enabled"}}</label>
    <div class="form-fields">
      <input type="checkbox" name="enabled" {{checked config.enabled}} />
    </div>
  </div>
  {{/if}}

  {{#if showSpeaker}}
  <div class="form-group">
    <label>{{localize "DIALOGUER.Speaker"}}</label>
    <div class="form-fields dialoguer-row" data-drop="speaker">
      <input type="text" name="speakerUuid" value="{{config.speakerUuid}}" placeholder="Scene.xxx.Token.yyy" />
      <button type="button" data-action="useSelected">{{localize "DIALOGUER.UseSelected"}}</button>
    </div>
    <p class="hint">{{localize "DIALOGUER.SpeakerHint"}}</p>
  </div>
  {{/if}}

  <div class="form-group">
    <label>{{localize "DIALOGUER.Portrait"}}</label>
    <div class="form-fields dialoguer-row">
      <input type="text" name="portrait" value="{{config.portrait}}" />
      <button type="button" data-action="pickPortrait">{{localize "DIALOGUER.Browse"}}</button>
    </div>
    <p class="hint">{{localize "DIALOGUER.PortraitHint"}}</p>
  </div>

  <div class="form-group stacked">
    <label>{{localize "DIALOGUER.Script"}}</label>
    <div class="form-fields">
      <textarea name="script" rows="8">{{config.script}}</textarea>
    </div>
    <p class="hint">{{localize "DIALOGUER.ScriptHint"}}</p>
  </div>

  <div class="form-group">
    <label>{{localize "DIALOGUER.Audience"}}</label>
    <div class="form-fields">
      <select name="audience">
        {{selectOptions audiences selected=config.audience localize=true}}
      </select>
    </div>
  </div>

  <div class="form-group">
    <label>{{localize "DIALOGUER.Theme"}}</label>
    <div class="form-fields">
      <select name="theme">
        {{selectOptions themes selected=config.theme localize=true}}
      </select>
    </div>
    <p class="hint">{{localize "DIALOGUER.ThemeHint"}}</p>
  </div>

  <div class="form-group">
    <label>{{localize "DIALOGUER.Once"}}</label>
    <div class="form-fields">
      <input type="checkbox" name="once" {{checked config.once}} />
    </div>
  </div>

  <div class="form-group">
    <label>{{localize "DIALOGUER.Hop"}}</label>
    <div class="form-fields">
      <input type="checkbox" name="hop" {{checked config.hop}} />
    </div>
  </div>

  {{#if showPlayerTokensOnly}}
  <div class="form-group">
    <label>{{localize "DIALOGUER.PlayerTokensOnly"}}</label>
    <div class="form-fields">
      <input type="checkbox" name="playerTokensOnly" {{checked config.playerTokensOnly}} />
    </div>
    <p class="hint">{{localize "DIALOGUER.PlayerTokensOnlyHint"}}</p>
  </div>
  {{/if}}

  <div class="form-group">
    <label>{{localize "DIALOGUER.TypingMs"}}</label>
    <div class="form-fields">
      <input type="number" name="typingMs" value="{{config.typingMs}}" min="0" max="200" step="1" />
    </div>
    <p class="hint">{{localize "DIALOGUER.TypingMsHint"}}</p>
  </div>

  <div class="form-group stacked">
    <label>{{localize "DIALOGUER.BlipPitch"}}</label>
    <div class="form-fields dialoguer-pitch">
      <span class="dialoguer-pitch-end">{{localize "DIALOGUER.BlipPitchLow"}}</span>
      <input type="range" min="50" max="2000" step="10" value="{{blipPitchSlider}}" data-blip-pitch-slider />
      <span class="dialoguer-pitch-end">{{localize "DIALOGUER.BlipPitchHigh"}}</span>
      <input type="number" name="blipPitch" value="{{config.blipPitch}}" min="50" max="2000" step="10" placeholder="980" />
    </div>
    <p class="hint">{{localize "DIALOGUER.BlipPitchHint"}}</p>
  </div>

  <footer class="form-footer dialoguer-actions">
    <button type="button" data-action="resetHistory">{{localize "DIALOGUER.ResetHistory"}}</button>
    <button type="button" data-action="test">{{localize "DIALOGUER.Test"}}</button>
    <button type="submit"><i class="fa-solid fa-save"></i> {{localize "DIALOGUER.Save"}}</button>
  </footer>
</div>
