{
  "id": "dialoguer",
  "title": "Dialoguer",
  "description": "Undertale-style dialogue overlays for Foundry VTT. Walk onto a tile or region, see the NPC's portrait and typed text, and watch the token hop while it talks.",
  "version": "0.1.2",
  "compatibility": {
    "minimum": "13",
    "verified": "14"
  },
  "authors": [
    {
      "name": "suideDev",
      "url": "https://github.com/suideDev"
    }
  ],
  "esmodules": ["scripts/module.js"],
  "styles": ["styles/dialoguer.css"],
  "languages": [
    {
      "lang": "en",
      "name": "English",
      "path": "lang/en.json"
    }
  ],
  "socket": true,
  "documentTypes": {
    "RegionBehavior": {
      "dialogue": {}
    }
  },
  "url": "https://github.com/suideDev/Foundry-Dialoguer",
  "bugs": "https://github.com/suideDev/Foundry-Dialoguer/issues",
  "manifest": "https://github.com/suideDev/Foundry-Dialoguer/releases/latest/download/module.json",
